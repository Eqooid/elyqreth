# Backend-only NON-SECRET settings for the separate production Compose file.
# Set existing owner and canonical HTTPS origin. Provision accounts using the existing trusted CLI.
AUTH_MODE=local
AUTH_SESSION_SECONDS=3600
AGENT_REGISTRY_ENABLED=true
AGENT_REGISTRY_OWNER_ID=REPLACE_WITH_EXISTING_OWNER_UUID
CORS_ORIGINS=https://city.example.invalid
CITY_READ_ENABLED=true
COLLABORATION_READ_ENABLED=true
CITY_INTERACTION_ENABLED=false
RUNTIME_ENABLED=false
# Only with RUNTIME_ENABLED=true: 100..20000 ms, default 15000; plus 5000 ms finalization.
# RUNTIME_DRAIN_TIMEOUT_MS=15000
RUNTIME_LLM_ENABLED=false
RUNTIME_TOOLS_ENABLED=false
EXTERNAL_ORCHESTRATORS_ENABLED=false
# OIDC alternative: remove AUTH_SESSION_SECONDS, select AUTH_MODE=oidc and provide the existing
# AUTH_OIDC_ISSUER/AUDIENCE/JWKS/SUBJECTS public verification settings. No local fallback.
# Do not put DATABASE_URL or credentials here: use the protected Compose secret mounts.
