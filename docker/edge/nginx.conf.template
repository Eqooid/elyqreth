worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    log_format safe escape=json '{"component":"edge","requestId":"$request_id","method":"$request_method","route":"$route_kind","status":$status,"duration":$request_time,"client":"$remote_addr","upstreamStatus":"$upstream_status"}';
    access_log /dev/stdout safe;
    map $uri $route_kind { default static; ~^/api/v1/ api; /health health; }
    limit_req_zone $binary_remote_addr zone=api_rate:1m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=login_rate:1m rate=6r/m;
    limit_conn_zone $binary_remote_addr zone=connections:1m;
    limit_req_status 429;
    limit_conn_status 429;
    client_max_body_size 64k;
    client_body_timeout 15s;
    client_header_timeout 10s;
    large_client_header_buffers 2 20k;
    keepalive_timeout 15s;
    send_timeout 30s;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 2s;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_tickets off;
    ssl_session_cache shared:TLS:1m;
    ssl_session_timeout 10m;
    server { listen 8080 default_server; server_name _; return 404; }
    server {
        listen 8080;
        server_name @@HOST@@;
        return 308 https://@@AUTHORITY@@$request_uri;
    }
    server { listen 8443 ssl default_server; ssl_reject_handshake on; return 421; }
    server {
        listen 8443 ssl;
        server_name @@HOST@@;
        ssl_certificate /run/secrets/tls_certificate;
        ssl_certificate_key /run/secrets/tls_private_key;
        # Reject an unexpected HTTP authority even when SNI selected this server.
        if ($http_host != "@@AUTHORITY@@") { return 421; }
        if ($http_upgrade != "") { return 400; }
        limit_conn connections 32;
        add_header Strict-Transport-Security "@@HSTS@@" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; worker-src 'none'" always;
        add_header X-Request-Id $request_id always;
        proxy_http_version 1.1;
        proxy_set_header Host "@@AUTHORITY@@";
        proxy_set_header X-Forwarded-Host "@@AUTHORITY@@";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port "@@PORT@@";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
        proxy_set_header Upgrade "";
        proxy_set_header X-User-Id "";
        proxy_set_header X-Owner-Id "";
        proxy_set_header X-Role "";
        proxy_hide_header X-Request-Id;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Strict-Transport-Security;
        proxy_connect_timeout 3s;
        proxy_send_timeout 30s;
        # Native HTTP execute has a 30-second deadline plus bounded cooperative cancellation.
        proxy_read_timeout 45s;
        proxy_next_upstream off;
        proxy_redirect off;
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_max_temp_file_size 0;
        proxy_intercept_errors off;
        error_page 502 503 504 = /_edge_unavailable;
        set $api_origin http://api:3001;
        set $web_origin http://web:8080;
        location = /_edge_unavailable { internal; default_type text/plain; return 503 "Service unavailable.\n"; }
        location = /health { access_log off; default_type text/plain; return 200 "ok\n"; }
        location = /api/v1/auth/login {
            limit_req zone=login_rate burst=5 nodelay;
            proxy_pass $api_origin$request_uri;
        }
        # These existing controller families are the entire public API surface.
        location ~ ^/api/v1/(auth/(me|logout)$|agents(/|$)|tasks(/|$)|executions(/|$)|cities(/|$)|collaborations(/|$)|collaboration-activity(/|$)) {
            limit_req zone=api_rate burst=40 nodelay;
            proxy_pass $api_origin$request_uri;
        }
        location /api { return 404; }
        location ~ ^/(ready|metrics|admin|internal|debug|webhooks)(/|$) { return 404; }
        location ~ /\. { return 404; }
        location / {
            if ($request_method !~ ^(GET|HEAD)$) { return 405; }
            proxy_read_timeout 30s;
            proxy_pass $web_origin$request_uri;
        }
    }
    # Namespace-only process probe; never routed by the public server.
    server {
        listen 127.0.0.1:8081;
        access_log off;
        location = /health { return 200 "ok\n"; }
        location / { return 404; }
    }
}
