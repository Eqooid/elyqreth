# Optional apps/api/.env. Process environment takes precedence.
# Feature blocks below describe AUTH_MODE=disabled legacy token mode unless stated otherwise.
# For named local/OIDC backend authentication use the AUTH_MODE section at the end.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence is optional for development/test liveness-only startup. Production requires it. Uncomment and replace before use.
# Use a restricted application role; migrate with a separate schema-owner role.
# DATABASE_URL=postgresql://elyqreth_app:replace_with_local_password@127.0.0.1:5432/elyqreth
# DATABASE_SSL_MODE=disable
# DATABASE_POOL_MAX=5
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_IDLE_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# Migration/preflight process only: must exactly match the explicitly reviewed URL database.
# Required for production migration commands, not API serve.
# DATABASE_MIGRATION_TARGET=elyqreth
# Production also requires the bootstrap-owned T07 role contract; see phase-6/database-migrations.md.
# Production requires verify-full TLS using a trusted certificate chain.

# Agent Registry + Task/Execution APIs: OFF by default. Local development only.
# These APIs share the T04 access boundary; never enable in production.
# Requires DATABASE_URL above and a separately provisioned, existing owner + orchestrator.
AGENT_REGISTRY_ENABLED=false
# AGENT_REGISTRY_OWNER_ID=replace_with_existing_owner_uuid
# Generate at least 32 random bytes (hex or base64url), store only in your ignored .env.
# AGENT_REGISTRY_TOKEN=replace_with_random_local_development_credential
# Enabling requires API_HOST=127.0.0.1 or ::1 (not localhost or 0.0.0.0).

# Optional read-only city projection audience. Never reuse the operator token.
# Requires registry/database and loopback development/test above; no runtime/LLM needed.
CITY_READ_ENABLED=false
# CITY_READ_TOKEN=replace_with_a_different_random_local_read_credential
# Only the existing city/catalog is supported. No browser code embeds this token.
# CITY_READ_CITY_ID=elyqreth

# Optional delegated city interaction. Separate from BOTH operator and city-read tokens.
# Default deny; local loopback development/test only. No production user/tenant login.
CITY_INTERACTION_ENABLED=false
# CITY_INTERACTION_TOKEN=replace_with_a_third_random_local_credential
# Required nonempty JSON UUID list (max 20); Agents also need enabled PASSIVE city bindings.
# CITY_INTERACTION_AGENT_IDS=["replace_with_reviewed_agent_uuid"]
# Optional explicit LLM text disclosure subset; default structured rule-based results only.
# CITY_INTERACTION_TEXT_AGENT_IDS=[]

# Optional INTERNAL native runtime. text.stats.v1 is compiled, never auto-run.
# Requires the local registry above; production enablement is rejected.
# T11: enabling runtime also enables guarded loopback HTTP operations; bearer token required.
RUNTIME_ENABLED=false
# Optional only when runtime is enabled: bounded graceful drain before cancellation.
# RUNTIME_DRAIN_TIMEOUT_MS=15000
# Only set RUNTIME_BINDINGS when enabled: a JSON array of reviewed bindings
# {agentId,orchestratorId,definition}. See docs/ai-agent-platform/phase-2/rule-based-runtime.md.
# No credentials, tool grants, scripts, or model endpoints belong in bindings.

# Optional provider catalog. Ollama and OpenAI register without startup network calls.
# Enabling an unregistered profile fails startup. Keep false for rule-based work.
RUNTIME_LLM_ENABLED=false
# Only set the following when enabling a reviewed profile with an installed adapter:
# LLM_PROFILES=[{"id":"local.small","profileVersion":1,"providerId":"ollama","model":"operator-approved-model","capabilities":{"text":true,"transportAbort":true,"remoteCancellation":"unknown","structuredOutput":"none","toolCalls":false,"streaming":false,"tokenUsage":"optional"},"endpoint":{"origin":"http://127.0.0.1:11434","network":"local","allowedAddresses":["127.0.0.1"]}}]
# LLM_REQUEST_TIMEOUT_MS=60000
# LLM_MAX_OUTPUT_TOKENS=512
# LLM_ALLOW_PAID=false
# OpenAI profiles also need credentialEnv (such as OPENAI_API_KEY),
# explicit paid consent, HTTPS and approved public addresses. Never put keys in JSON.
# Configure actual credentials only in process environment or the ignored API .env.
# Native Ollama accepts local-network profiles only, without credentialEnv.
# See docs/ai-agent-platform/phase-2/ollama-adapter.md for opt-in live diagnostics.

# OpenAI: fixed https://api.openai.com origin + public approved DNS addresses.
# Set LLM_ALLOW_PAID=true only after cloud data/spend review. No provider fallback.
# OPENAI_API_KEY=replace_in_ignored_env_only
# Model comes from LLM_PROFILES; OPENAI_MODEL and LLM_MODEL aliases are rejected.
# Live paid probe is OFF unless ELYQRETH_OPENAI_LIVE=true is explicitly exported.
# See docs/ai-agent-platform/phase-2/openai-adapter.md for a reviewed profile example.

# Compiled tools are OFF by default. No automatic invocation or LLM loop.
# Requires the existing loopback runtime/registry and reviewed Agent binding.
RUNTIME_TOOLS_ENABLED=false
# Set the following only when explicitly enabling reviewed tool grants:
# RUNTIME_TOOL_ALLOWLIST=["tool.calculator.v1","tool.current_datetime.v1"]
# Per-definition maxToolCalls <= 2, toolTimeoutMs <= 2000; sequential only.
# Current text.stats.v1 remains zero-tool; llm.text.v1 uses reviewed grants.
# See docs/ai-agent-platform/phase-2/safe-tools.md.

# T09 LLM strategy: llm.text.v1, Agent type LLM, native route, trusted local CLI or guarded T11 HTTP execution.
# RUNTIME_BINDINGS stores reviewed providerProfile + optional systemInstructions,
# at most 3 provider rounds / 2 tool calls and an aggregate output allowance <=4096.
# Set toolCalls:true in a reviewed profile only for a compatible tool-capable model.
# Agent JSON stays category/color only; Task input never selects provider/tools.
# See docs/ai-agent-platform/phase-2/llm-agent.md for binding and execution workflow.
# Phase 5 T08: disabled by default; langgraph.v1 is compiled, observation-only.
EXTERNAL_ORCHESTRATORS_ENABLED=false
# EXTERNAL_ORCHESTRATORS is a reviewed server-only JSON profile array (see phase-5/adapter-foundation.md).
# Credential references use EXTERNAL_SECRET_* environment names. Never put secret values in profiles.


# LangGraph reference: see tools/langgraph-reference/connection.example.json and
# docs/ai-agent-platform/phase-5/reference-integration.md. Replace its owner/connection UUIDs
# with approved existing records; local endpoint 127.0.0.1:20240 is an explicit trusted allowlist.
# Hosted profiles need credentialRef: EXTERNAL_SECRET_LANGGRAPH (server-only X-Api-Key).
# Do not put keys in JSON profiles or expose this local operator configuration publicly.

# T10: separate read-only collaboration browser audience; operator/provider tokens stay server-only.
COLLABORATION_READ_ENABLED=false
# COLLABORATION_READ_TOKEN=<distinct strong random 32-128 character token>
# Requires the existing loopback registry and PostgreSQL. Never use VITE_* or commit secrets.

# Phase 6 T02: production CONFIGURATION contract, not production access/deployment.
# See docs/ai-agent-platform/phase-6/configuration-contracts.md and configuration-inventory.md.
# Production requires explicit NODE_ENV=production, API_HOST, API_PORT, CORS_ORIGINS,
# DATABASE_URL. Use exact HTTPS origins (no localhost/loopback/wildcards).
# DATABASE_SSL_MODE must be verify-full (also the production default).
# No built-in postgres superuser, recognizable test DB or default/placeholder password.
# Without an explicit validated AUTH_MODE, privileged production flags remain prohibited.
# Named private-operator backend authentication is now available; frontend login is T04. Never set NODE_ENV=development to evade production restrictions.
# Inject real secrets backend-only at launch, never into VITE_* or tracked files.
# Staging uses NODE_ENV=production with separately isolated DB/credentials/origins.
# No SESSION_SECRET, TRUST_PROXY, WORKER_CONCURRENCY or public webhook variables
# are consumed yet. Inventing them does not enable those controls.

# Named private-operator authentication: choose one mode per installation.
# Default preserves the restricted development-token setup above.
AUTH_MODE=disabled
# AUTH_MODE=local uses AGENT_REGISTRY_ENABLED=true and an existing OWNER_ID,
# with NO AGENT_REGISTRY_TOKEN/CITY_READ_TOKEN/COLLABORATION_READ_TOKEN settings.
# CITY_INTERACTION_ENABLED must remain false in account modes.
# AUTH_SESSION_SECONDS=3600
# Provision named accounts only with the stdin-only trusted account command.
# No default password or public signup. See phase-6/authentication-modes.md.
# AUTH_MODE=oidc instead requires all four reviewed server-only settings:
# AUTH_OIDC_ISSUER=https://identity.example/realms/elyqreth
# AUTH_OIDC_AUDIENCE=elyqreth-api
# AUTH_OIDC_JWKS=<reviewed public JWKS JSON; no private keys>
# AUTH_OIDC_SUBJECTS=[{"subject":"approved-provider-subject","role":"operator"}]
# RS256 API access tokens only; ID/unknown-purpose JWTs are rejected.
# No automatic fallback, remote JWKS fetch, browser secret or provider logout.

# T05 backend-only file injection: use the value OR its _FILE counterpart, never both.
# DATABASE_URL_FILE=/run/secrets/database_url
# DATABASE_SSL_CA_FILE=/run/config/database-ca.pem
# Production secrets must be root/app owned, not world-readable or group/world-writable.
# Existing *_API_KEY and EXTERNAL_SECRET_* references accept corresponding _FILE inputs.
# T10: external references and credential values must be distinct per connection.
# Example key path for an approved local profile: EXTERNAL_SECRET_REFERENCE_FILE=/absolute/private/key
# Production external activation remains rejected; no public webhook or account-mode source grant exists.
# See docs/ai-agent-platform/phase-6/external-connectivity.md for rotation and target approval gates.
# Opaque local sessions need no SESSION_SECRET. No worker/queue configuration is invented.
# Readiness: loopback-only /ready, separate from public process-only /health.
# docs/ai-agent-platform/phase-6/container-hardening.md

# T08 backup/restore uses a separate operator process and protected stdin JSON requests.
# Do not add backup credentials or recovery keys to API/browser configuration.
# See docs/ai-agent-platform/phase-6/backup-recovery.md.
